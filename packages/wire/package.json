{
  "name": "@forge/wire",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Native TypeScript client of the Crucible wire protocol (frame codec + CBOR + handshake + mTLS), ported from crdb cdb-wire.",
  "license": "LicenseRef-YouSource-Proprietary",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@forge/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
