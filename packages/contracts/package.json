{
  "name": "@forge/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared Console contracts: generated Crucible wire DTO types, branded ids, error taxonomy, binding-manifest shape.",
  "license": "LicenseRef-YouSource-Proprietary",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
