# /etc/console-enroll/config.env -- the Console ZTP enrollment config (IP-CONSOLE-00-SIDECAR-TPM).
#
# Read by `console-enroll` (run once at install to mint the engine identity). Copy to
# /etc/console-enroll/config.env and fill the deployment values. CONSOLE_ENROLL_CERT_OUT is set by
# install.sh to the sidecar's engine_cert path, so it is omitted here. There is NO key file: the identity
# key is non-exportable and TPM-resident (the sidecar re-derives it at runtime and signs in-device).

# ---- the federated IdP (operator MFA, device-authorization grant) ----
# The IdP host + device-code client. The client needs the device-authorization grant. DPoP is NOT
# required: the Console enrolls a TPM key and the node binds the token to the attested key itself (the
# NodeEstablished path), so the token is a plain bearer token.
CONSOLE_ENROLL_IDP_HOST=your-tenant.us.auth0.com
CONSOLE_ENROLL_IDP_CLIENT_ID=your-device-code-client-id
CONSOLE_ENROLL_IDP_SCOPE=openid
CONSOLE_ENROLL_IDP_AUDIENCE=https://crucibledb/enroll
# Endpoint paths (defaults shown; override only if your IdP differs).
#CONSOLE_ENROLL_IDP_DEVICE_PATH=/oauth/device/code
#CONSOLE_ENROLL_IDP_TOKEN_PATH=/oauth/token

# ---- the node's enrollment service (the bootstrap wire) ----
# host:port of the node's enrollment listener (:7443), the TLS server name in its leaf, and the pinned
# enroll-CA (the node's /etc/cdb/ztp/enroll-tls/ca.pem, exported to the Console host).
CONSOLE_ENROLL_NODE_ADDR=NODE_IP:7443
CONSOLE_ENROLL_NODE_SERVER_NAME=enroll.localhost
CONSOLE_ENROLL_NODE_CA=/etc/console-enroll/enroll-ca.pem

# ---- the TPM device identity ----
# The TCTI to the host TPM (default shown). The attestation nonce MUST equal the node's configured
# enrollment_bootstrap.attestation_nonce_b64u (base64url). On a GCE Shielded VM the EK certificate is not
# in TPM NV -- export it (getShieldedInstanceIdentity) and point CONSOLE_ENROLL_EK_CERT at the PEM; omit
# on a TPM whose EK cert is in the TCG-standard NV index.
#CONSOLE_ENROLL_TCTI=device:/dev/tpmrm0
CONSOLE_ENROLL_ATTEST_NONCE=replace-with-the-node-attestation-nonce-b64url
#CONSOLE_ENROLL_EK_CERT=/etc/console-enroll/ek-cert.pem

# ---- the Console's proposed identity ----
# The console-bff FQDN (used on first enrollment; once bound to the TPM identity the node returns the
# bound name). The Console's engine identity is a fixed SERVICE peer: install.sh step [4b] pins its cert
# fingerprint into the node config with a Global-Admin grant (all wire planes incl. Delegation) via
# `cdb-mkconfig --add-wire-peer`, so the BFF's engine access is decoupled from any human MFA (the human
# hop is gated at the BFF). Set CONSOLE_PEER_TENANT (see install.sh) to the node tenant the peer is
# attributed to. This replaces the earlier per-operator enrolled-role grant.
CONSOLE_ENROLL_FQDN=console-bff.node.example.crucibledb
