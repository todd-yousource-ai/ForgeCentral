# /etc/console-enroll/config.env -- the Console ZTP enrollment config (IP-CONSOLE-00-DEPLOY D.3a-console).
#
# Read by `console-enroll` (run once at install to mint the engine identity). Copy to
# /etc/console-enroll/config.env and fill the deployment values. CONSOLE_ENROLL_CERT_OUT / _KEY_OUT are set
# by install.sh to the sidecar's engine_cert/engine_key paths, so they are omitted here.

# ---- the federated IdP (operator MFA, device-authorization grant) ----
# The IdP host + device-code client. The client MUST have the device-authorization grant AND DPoP enabled:
# the Console enrolls a SOFTWARE key, which the engine admits only via a DPoP `cnf`-bound token.
CONSOLE_ENROLL_IDP_HOST=your-tenant.us.auth0.com
CONSOLE_ENROLL_IDP_CLIENT_ID=your-device-code-client-id
CONSOLE_ENROLL_IDP_SCOPE=openid
CONSOLE_ENROLL_IDP_AUDIENCE=https://crucibledb/enroll
# Endpoint paths (defaults shown; override only if your IdP differs).
#CONSOLE_ENROLL_IDP_DEVICE_PATH=/oauth/device/code
#CONSOLE_ENROLL_IDP_TOKEN_PATH=/oauth/token

# ---- the node's enrollment service (the bootstrap wire) ----
# host:port of the node's enrollment listener, the TLS server name in its leaf, and the pinned enroll-CA.
CONSOLE_ENROLL_NODE_ADDR=NODE_IP:8443
CONSOLE_ENROLL_NODE_SERVER_NAME=enroll.localhost
CONSOLE_ENROLL_NODE_CA=/etc/console-enroll/enroll-ca.pem

# ---- the Console's proposed identity ----
# The console-bff FQDN: the cert CN + SAN, and the stable device anchor. The operator's IdP group must map
# to the `operator` AdminRole (node CDB_ENROLL_GROUP_ROLES), and the node must grant that role the wire
# planes (CDB_WIRE_ROLE_GRANTS='operator=data,delegation') for the delegated-read path to work.
CONSOLE_ENROLL_FQDN=console-bff.node.example.crucibledb
