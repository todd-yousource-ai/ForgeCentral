# /etc/console-bff/config.env -- the Console BFF environment (IP-CONSOLE-00-DEPLOY D.1).
#
# EnvironmentFile for console-bff.service. The BFF is configured entirely by FC_* env (no config file, no
# durable store). The engine is reached ONLY through the crypto sidecar's egress on loopback (the BFF holds
# no TLS material); a routable FC_ENGINE_HOST is refused fail-closed. Copy to /etc/console-bff/config.env
# and fill the deployment-specific values.

# ---- HTTP + engine wiring (required) ----
# The BFF admin HTTP listener. The sidecar's admin terminator (:8443) forwards decrypted browser traffic
# here (admin_upstream in the sidecar config points at 127.0.0.1:FC_HTTP_PORT).
FC_HTTP_PORT=8787
# The crypto sidecar egress (loopback only): the BFF speaks plaintext wire here; the sidecar originates the
# engine mTLS to :7878. Must match the sidecar's egress_addr.
FC_ENGINE_HOST=127.0.0.1
FC_ENGINE_PORT=8789
FC_LOG_LEVEL=info

# ---- operator auth (OIDC) -- omit the whole block to run without auth (dev only) ----
# When FC_OIDC_ISSUER is set, all three OIDC vars are required or the BFF fails closed at startup.
#FC_OIDC_ISSUER=https://your-tenant.example/
#FC_OIDC_CLIENT_ID=your-console-client-id
#FC_OIDC_ROLE_CLAIM=https://your-namespace/groups
# The RBAC map (JSON): groups -> Console role + tenant. See apps/bff/src/auth/rbac.ts.
#FC_RBAC_CONFIG={"groupRoles":{},"localRbac":{},"defaultTenant":""}

# ---- session + cache (optional; sane defaults compiled in) ----
#FC_SESSION_TTL_MS=3600000
#FC_SESSION_COOKIE=fc_session
# MUST be true in production (Secure cookie); only false behind a local dev proxy.
FC_SESSION_COOKIE_SECURE=true
#FC_CACHE_TTL_MS=5000
#FC_REQUEST_TIMEOUT_MS=15000
