# ForgeCentral (Console) pnpm/npm configuration -- supply-chain hardening. See DEPENDENCY-POLICY.md.

# Registry pin: resolve packages ONLY from the public npm registry. Blocks a rogue mirror and a
# dependency-confusion resolution from an unexpected host.
registry=https://registry.npmjs.org/

# Tamper detection: fail the install if a stored package's content hash does not match the lockfile.
verify-store-integrity=true

# Install-script lockdown is expressed as package.json > pnpm.onlyBuiltDependencies (deny-by-default;
# only listed packages may run lifecycle scripts). check-supply-chain.mjs enforces the allowlist in the
# gate. Do NOT set ignore-scripts=false or dangerouslyAllowAllBuilds here.
